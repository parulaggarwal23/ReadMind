# Copy to .env and fill in.  (.env is git-ignored)

# GitHub personal access token (classic, no scopes needed for public repos) — 5000 requests/hour
GITHUB_TOKEN=

# LLM used for answering: gemini | openai | ollama | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# LLM used as the judge in evaluation (ideally different / stronger than the answering model)
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-pro

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
USE_RERANKER=true
RERANK_MODEL=BAAI/bge-reranker-base
TOP_K_CANDIDATES=30
TOP_K_FINAL=8
HISTORY_QUOTA=0.5

CORS_ORIGINS=*
